{
	/*
	 * Type-check gate for CI (`npm run check`).
	 *
	 * History: this was once `echo 'Type checking temporarily disabled for CI'`,
	 * so worker-tests.yml type-checked nothing at all. The root cause was a stale
	 * tsconfig (workers-types v5 dropped the dated `/2023-07-01` subpath), not the
	 * code — but 261 errors had accumulated behind it by the time it was found. It
	 * was then replaced by an explicit allowlist of the files that already passed.
	 *
	 * All 26 production errors are now fixed, so the allowlist is gone: this gates
	 * everything under `src/` and excludes only the test mocks. That inversion is
	 * the point — under an allowlist a newly added production file was ungated by
	 * default, which is exactly how the gap re-opens.
	 *
	 * `src/__tests__` still reports ~236 errors, almost all in hand-rolled mocks
	 * (unknown-typed fixtures, illegal casts, wrong `vi.mocked` arities). They are
	 * tracked in docs/specs/tech-debt-2026-07.md; `npm run check:all` shows them.
	 * Do not add production paths to `exclude`.
	 */
	"extends": "./tsconfig.json",
	"include": ["src/**/*.ts"],
	"exclude": ["src/__tests__/**"]
}
